# Export these variables in your shell; this file is not automatically loaded.
SOURCEBOOK_DATA_DIR=.data
SOURCEBOOK_PROVIDER=extractive

# Optional local generated answers. Set a model already installed in Ollama.
# SOURCEBOOK_PROVIDER=ollama
# SOURCEBOOK_BASE_URL=http://127.0.0.1:11434
# SOURCEBOOK_MODEL=your-installed-model

# Optional answer style. "quote" (default) lets the model write the quotation; "span" makes it
# select a sentence number and the application writes the quotation from source text, so a
# quotation cannot be a paraphrase and a statement cannot contain words the source lacks.
# SOURCEBOOK_ANSWER_STYLE=span

# Optional Chat Completions-compatible provider (base includes /v1).
# SOURCEBOOK_PROVIDER=compatible
# SOURCEBOOK_BASE_URL=https://your-provider.example/v1
# SOURCEBOOK_MODEL=your-model-id
# SOURCEBOOK_API_KEY=your-key

# Optional models; install with uv sync --extra semantic first.
# SOURCEBOOK_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# SOURCEBOOK_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
